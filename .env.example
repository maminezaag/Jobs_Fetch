# Copie ce fichier en ".env" pour un test EN LOCAL et remplis tes vraies valeurs.
# Sur GitHub Actions, ces mêmes noms sont définis comme "Secrets" du repo
# (voir README.md) — ne jamais committer un .env rempli.
#
# Pour charger ce fichier avant un test local :
#   export $(grep -v '^#' .env | xargs)
#   python job_watcher.py --config config.yaml --dry-run

# Adresse Gmail utilisée à la fois comme expéditeur et pour la connexion SMTP
GMAIL_ADDRESS=toncompte@gmail.com

# Mot de passe D'APPLICATION Gmail (PAS ton mot de passe de connexion habituel).
# À générer sur : https://myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes activée sur le compte)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Destinataire(s) des notifications — plusieurs adresses possibles, séparées
# par des virgules (ex. GMAIL_TO=toi@gmail.com,autre@example.com)
GMAIL_TO=toncompte@gmail.com
